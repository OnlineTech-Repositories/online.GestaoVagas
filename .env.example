# Configuração do Controle de Vagas. Copie para .env (fora do Git) para rodar localmente; em produção (Render), cadastre
# as mesmas variáveis em Environment. NUNCA coloque senhas reais neste arquivo: ele é versionado.

# ---- execução ------------------------------------------------------------------------------------------------------
# development: cookies sem "Secure" (http://localhost). Em produção deixe vazio (padrão: production).
NODE_ENV=development
# Porta local (o Render informa PORT sozinho).
PORTA=5067
# Endereço público, usado nos links dos e-mails (ex.: https://controle-vagas.onrender.com).
BASE_URL=http://localhost:5067

# ---- banco ---------------------------------------------------------------------------------------------------------
# Sem DATABASE_URL, usa SQLite em dados/controle-vagas.db (desenvolvimento). Em produção, o PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/banco
# DB_FILE=dados/controle-vagas.db

# ---- primeiro administrador (criado só se não houver nenhum; troca a senha no 1º acesso) ---------------------------
ADMIN_EMAIL=
ADMIN_SENHA=

# ---- dados de demonstração (só desenvolvimento) --------------------------------------------------------------------
# DADOS_DEMO=1
# SENHA_DEMO=

# ---- e-mail (MailerSend) -------------------------------------------------------------------------------------------
# O remetente precisa ser de um domínio verificado no MailerSend. Teste com: npm run email:teste -- --para voce@...
EMAIL_ATIVO=0
# MAILERSEND_API_KEY=
# EMAIL_REMETENTE=avisos@empresa.com.br
# EMAIL_NOME_REMETENTE=Controle de Vagas - Grupo ON LINE
