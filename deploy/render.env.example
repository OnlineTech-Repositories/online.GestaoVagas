# Variáveis de ambiente do serviço no Render (botão "Add from .env").
# Troque o que está entre <...>. NÃO coloque aqui senhas reais: este arquivo é versionado.
# O Render já define RENDER e PORT; a API detecta a plataforma por elas (proxy confiável e porta).

# Banco: a "Internal Database URL" do PostgreSQL do Render, colada como está (postgresql://...).
ConnectionStrings__Default=<internal-database-url>

# Endereço público do serviço, usado nos links dos e-mails.
App__BaseUrl=https://<nome-do-servico>.onrender.com

# Primeiro ADMIN (só é criado se não houver nenhum). Senha provisória: 8+ caracteres, maiúscula, número e especial;
# é trocada no primeiro acesso.
Seed__AdminEmail=<email-do-admin>
Seed__AdminPassword=<senha-provisoria-forte>

# E-mail: com false, as mensagens só aparecem no log. Para ligar: true + ApiKey + remetente verificado no SendGrid.
SendGrid__Enabled=false
# SendGrid__ApiKey=<api-key>
# SendGrid__FromEmail=<remetente-verificado>
